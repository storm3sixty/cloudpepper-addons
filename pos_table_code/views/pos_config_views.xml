<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_ui_designer" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.ui.designer</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='iface_big_scrollbars']" position="after">
                <separator string="POS UI Designer"/>
                <field name="ui_enable_drag_and_drop"/>
                <field name="ui_button_labels_json" widget="text" placeholder='{"Plan":"Zones","Table":"Tables"}'/>
                <field name="ui_sales_receipt_note" widget="text" placeholder="Extra sales receipt line"/>
                <field name="ui_kitchen_receipt_note" widget="text" placeholder="Extra kitchen receipt line"/>
            </xpath>
        </field>
    </record>
</odoo>
