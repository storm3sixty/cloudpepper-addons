<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_restaurant_table_form_inherit_table_code" model="ir.ui.view">
        <field name="name">restaurant.table.form.table.code</field>
        <field name="model">restaurant.table</field>
        <field name="inherit_id" ref="pos_restaurant.view_pos_restaurant_table_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="table_code" placeholder="e.g. Family Booth"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_restaurant_table_tree_inherit_table_code" model="ir.ui.view">
        <field name="name">restaurant.table.tree.table.code</field>
        <field name="model">restaurant.table</field>
        <field name="inherit_id" ref="pos_restaurant.view_pos_restaurant_table_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="table_code" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
