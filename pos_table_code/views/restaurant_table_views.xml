<record id="restaurant_floor_form_inherit_table_code" model="ir.ui.view">
    <field name="name">restaurant.floor.form.table.code</field>
    <field name="model">restaurant.floor</field>
    <field name="inherit_id" ref="pos_restaurant.restaurant_floor_form"/> <!-- Replace with actual floor form view ID -->
    <field name="arch" type="xml">
        <xpath expr="//field[@name='table_ids']/tree/field[@name='name']" position="after">
            <field name="table_code"/>
        </xpath>
    </field>
</record>


















