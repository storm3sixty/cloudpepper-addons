<odoo>
    <record id="restaurant_table_tree_inherit_code" model="ir.ui.view">
        <field name="name">restaurant.table.tree.code</field>
        <field name="model">restaurant.table</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_table_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="table_code"/>
            </xpath>
        </field>
    </record>
</odoo>












