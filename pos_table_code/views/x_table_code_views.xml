<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit the restaurant.table model form view -->
    <record id="restaurant_table_form_inherit_code" model="ir.ui.view">
        <field name="name">restaurant.table.form.code</field>
        <field name="model">restaurant.table</field>
        <field name="inherit_id" ref="point_of_sale.restaurant_table_form"/>
        <field name="arch" type="xml">
            <!-- Add our new field after table_number -->
            <xpath expr="//field[@name='table_number']" position="after">
                <field name="table_code" string="Table Name"/>
            </xpath>
        </field>
    </record>

    <!-- Add the field definition -->
    <record id="restaurant_table_model_extend" model="ir.model.fields">
        <field name="name">table_code</field>
        <field name="model">restaurant.table</field>
        <field name="field_description">Table Name</field>
        <field name="ttype">char</field>
    </record>
</odoo>
